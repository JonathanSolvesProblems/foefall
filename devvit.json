{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "foefall",
  "marketingAssets": {
    "icon": "assets/icon.png"
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": ["SUBMIT_POST", "SUBMIT_COMMENT", "SUBSCRIBE_TO_SUBREDDIT"]
    },
    "redis": true,
    "journeys": true
  },
  "menu": {
    "items": [
      {
        "label": "Foefall: post today's trial",
        "description": "Posts today's trial if it is not up yet",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-today"
      },
      {
        "label": "Foefall: post a fresh copy of today's trial",
        "description": "For testing: posts today's trial again",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-fresh"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade",
    "onPostDelete": "/internal/triggers/on-post-delete"
  },
  "scheduler": {
    "tasks": {
      "daily-trial": {
        "endpoint": "/internal/scheduler/daily-trial",
        "cron": "1 0 * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "forewarned_daily_dev"
  }
}